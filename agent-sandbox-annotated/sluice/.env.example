# =============================================================================
# .env.example - copy to .env and edit. Every key is optional.
# =============================================================================
#
# Parsed as DATA by lib/dotenv.sh, never executed. Variables that already
# exist in the environment take precedence over this file, and an EMPTY
# value means "use the default".
# Syntax: KEY=value | KEY='literal' | KEY="escapes \n and ${VAR}"

# -- engine -------------------------------------------------------------------
# Runtime state (runs, locks, demo workspace); default: <install dir>/var
SLUICE_VAR_DIR=
# Root for the stage inputs referenced by pipelines/nightly-ops.ini;
# default: $SLUICE_VAR_DIR/workspace
SLUICE_WORKSPACE=
# trace | debug | info | warn | error
SLUICE_LOG_LEVEL=info
# auto | always | never   (NO_COLOR=1 also disables colours)
SLUICE_COLOR=auto
# auto | flock | mkdir    (prefer mkdir on NFS)
SLUICE_LOCK_BACKEND=auto
# Lowest finding severity that turns a stage "warn": info|low|medium|high|critical
SLUICE_WARN_AT=medium

# -- integration: chat notifications (a secret: never commit a real URL) ------
# Slack incoming webhook, Mattermost, or a Discord webhook with "/slack" appended
SLUICE_WEBHOOK_URL=
# slack | generic
SLUICE_WEBHOOK_FORMAT=slack
# always | warn | failure | never
SLUICE_NOTIFY_ON=always

# -- stage inputs on a real host (empty = the workspace defaults) -------------
# e.g. /var/log/nginx/access.log*
SLUICE_ACCESS_LOGS=
# e.g. /etc/ssh/sshd_config
SLUICE_SSHD_CONFIG=
# e.g. /srv /var/www /etc
SLUICE_FS_AUDIT_PATHS=
# e.g. /etc/letsencrypt/live/*/fullchain.pem
SLUICE_CERT_PATHS=
# e.g. example.com:443 api.example.com:443
SLUICE_CERT_ENDPOINTS=
# e.g. /etc /srv/app/data
SLUICE_BACKUP_SOURCES=
# e.g. /var/backups/sluice
SLUICE_BACKUP_DIR=
# e.g. /var/www/status
SLUICE_PUBLISH_ROOT=
# e.g. "curl -fsS -o /dev/null http://localhost/status/"
SLUICE_PUBLISH_HEALTHCHECK=

# -- thresholds ---------------------------------------------------------------
SLUICE_MIN_FREE_MB=256
SLUICE_MEM_WARN_PCT=80
SLUICE_MEM_CRIT_PCT=90
SLUICE_DISK_WARN_PCT=80
SLUICE_DISK_CRIT_PCT=90
SLUICE_LOAD_WARN_PER_CPU=2.0
SLUICE_UPTIME_WARN_DAYS=365
SLUICE_TOP_N=5
SLUICE_MAX_5XX_PCT=2
SLUICE_MAX_P99_MS=1500
SLUICE_MAX_CLIENT_SHARE_PCT=30
SLUICE_FS_MAX_REPORT=25
SLUICE_CERT_WARN_DAYS=30
SLUICE_CERT_CRIT_DAYS=7

# -- backup retention and publishing ------------------------------------------
SLUICE_BACKUP_PREFIX=backup
SLUICE_BACKUP_KEEP_DAILY=7
SLUICE_BACKUP_KEEP_WEEKLY=4
SLUICE_BACKUP_KEEP_MONTHLY=6
SLUICE_PUBLISH_KEEP=5
